// Prisma клиент и връзка с PostgreSQL (DATABASE_URL от .env)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Роли на потребителите (ADMIN засега не се използва)
enum Role {
  STUDENT
  LECTURER
  ADMIN
}

// PLANNED (предстои) → OPEN (чекиране с RFID) → CLOSED (отсъстващите стават ABSENT)
enum SessionStatus {
  PLANNED
  OPEN
  CLOSED
}

// Използват се PRESENT и ABSENT; LATE и EXCUSED са резерв за бъдеще
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// Статус на Smart Catch-up пакет
enum CatchupStatus {
  READY
  COMPLETED
}

// Потребители (студенти и лектори); паролата се пази като bcrypt хеш
model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  createdAt    DateTime        @default(now())
  student      StudentProfile?
  lecturer     LecturerProfile?
}

// Студентски профил
// rfidUid: UID на RFID картата без двоеточия (напр. EA972406); walletSerial: Apple Wallet (изключено)
model StudentProfile {
  id             String              @id @default(cuid())
  userId         String              @unique
  facultyNumber  String              @unique
  program        String
  year           Int
  rfidUid        String?             @unique
  walletSerial   String              @unique @default(cuid())
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  attendance     AttendanceRecord[]
  catchups       CatchupPackage[]
  badges         StudentBadge[]
}

// Лекторски профил
model LecturerProfile {
  id       String   @id @default(cuid())
  userId   String   @unique
  title    String?
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses  Course[]
}

// Учебни дисциплини
// requiredSessions и badgeRules са за значките
model Course {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  description  String?
  lecturerId   String
  requiredSessions Int         @default(5)
  lecturer     LecturerProfile @relation(fields: [lecturerId], references: [id])
  enrollments  Enrollment[]
  sessions     ClassSession[]
  badgeRules   BadgeRule[]
}

// Записани студенти по курсове
model Enrollment {
  id        String         @id @default(cuid())
  studentId String
  courseId  String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([studentId, courseId])
}

// Лекции на курса и техният статус
model ClassSession {
  id          String              @id @default(cuid())
  courseId    String
  title       String
  syllabus    String?             // описание на темата от конспекта (използва се от AI)
  startsAt    DateTime
  endsAt      DateTime
  room        String
  status      SessionStatus       @default(PLANNED)
  createdAt   DateTime            @default(now())
  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendance  AttendanceRecord[]
  materials   Material[]
  catchups    CatchupPackage[]
}

// Присъствия – по един запис на студент за лекция
// source: RFID при сканиране; WALLET_QR е от старата версия
model AttendanceRecord {
  id         String           @id @default(cuid())
  studentId  String
  sessionId  String
  status     AttendanceStatus
  checkedAt  DateTime?
  source     String           @default("WALLET_QR")
  student    StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session    ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([studentId, sessionId])
}

// Материали за AI резюмето; openaiFileId – файлът, вече качен в OpenAI
model Material {
  id          String       @id @default(cuid())
  sessionId   String
  title       String
  fileName    String
  mimeType    String
  localPath   String
  openaiFileId String?
  createdAt   DateTime     @default(now())
  session     ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Smart Catch-up за отсъствал студент
model CatchupPackage {
  id          String         @id @default(cuid())
  studentId   String
  sessionId   String
  title       String
  summary     String
  keyConcepts Json
  quiz        Json
  status      CatchupStatus  @default(READY)
  score       Int?
  maxScore    Int?
  createdAt   DateTime       @default(now())
  completedAt DateTime?
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session     ClassSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([studentId, sessionId])
}

// Значки за пълно присъствие (в момента не се раздават)
model BadgeRule {
  id          String  @id @default(cuid())
  courseId    String
  name        String
  description String
  benefit     String
  requiredPresent Int
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  badges      StudentBadge[]
}

// Издадени значки
model StudentBadge {
  id               String         @id @default(cuid())
  studentId        String
  badgeRuleId      String
  verificationCode String         @unique @default(cuid())
  issuedAt         DateTime       @default(now())
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeRule        BadgeRule      @relation(fields: [badgeRuleId], references: [id], onDelete: Cascade)
  @@unique([studentId, badgeRuleId])
}
